# ============================================================================
# arunlinux — daily apps + all the package managers
# VS Code + Chrome repos are added by scripts/pkgmanagers-setup.sh during
# build (chroot hook) so we always ship the latest releases.
#
# NOTE (trixie): policykit-1 → polkitd (renamed), polkitd-pkla removed,
# libfuse3-3 removed (fuse3 pulls its own lib), neofetch removed (→ inxi).
# ============================================================================

# --- Package managers ---
flatpak
snapd
libfuse2
fuse3
appstream

# --- Daily apps from Debian repos ---
gimp
vlc
transmission-gtk
thunderbird
libreoffice-writer
libreoffice-calc
libreoffice-impress
gnome-calculator
baobab
gnome-disk-utility
gparted
timeshift
synaptic
bleachbit
redshift
flameshot
inxi
earlyoom
zram-tools
preload

# --- Fonts for VS Code / Chrome / docs ---
fonts-firacode
fonts-jetbrains-mono
fonts-cascadia-code

# --- Network extras ---
openssh-client
network-manager-openvpn-gnome

# --- Security (firewall, auto security updates, brute-force protection) ---
# Configured by scripts/security-harden.sh (runs during install, safe to re-run)
ufw
fail2ban
unattended-upgrades
apt-listchanges
