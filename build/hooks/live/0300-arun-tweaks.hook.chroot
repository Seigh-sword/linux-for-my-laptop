#!/bin/bash
# live-build chroot hook: copy arunlinux tweaks + apps into the image.
# Expects /arun-src inside the chroot (placed via config/includes.chroot).
set -e
echo "==> [arunlinux hook] applying arunlinux tweaks + apps..."

SRC=""
for cand in /arun-src /root/arun-src "$(pwd)/arun-src"; do
  [ -d "$cand" ] && SRC="$cand" && break
done
if [ -z "$SRC" ]; then
  echo "[WARN] arun-src not found, skipping (post-install script covers it)"
  exit 0
fi

# --- Kernel / sysctl / zram / modprobe configs ---
install -Dm644 "$SRC/kernel/sysctl/99-arunlinux.conf" /etc/sysctl.d/99-arunlinux.conf
# Install BOTH zram configs (each backend reads its own file; the other is ignored)
install -Dm644 "$SRC/kernel/zram/zram-generator.conf" /etc/systemd/zram-generator.conf
install -Dm644 "$SRC/kernel/zram/zram-swap.default" /etc/default/zramswap
install -Dm644 "$SRC/kernel/modprobe/i915.conf" /etc/modprobe.d/i915-arunlinux.conf
install -Dm644 "$SRC/kernel/earlyoom/earlyoom.default" /etc/default/earlyoom

# --- os-release branding (version baked in by build-iso.sh) ---
ARUN_VER="$(cat "$SRC/VERSION" 2>/dev/null || echo "1.0")"
sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"arunlinux $ARUN_VER\"/" /etc/os-release
sed -i 's/^NAME=.*/NAME="arunlinux"/' /etc/os-release
sed -i "s/^VERSION_ID=.*/VERSION_ID=\"$ARUN_VER\"/" /etc/os-release
echo 'HOME_URL="https://github.com/Seigh-sword/arunlinux"' >> /etc/os-release

# --- Custom apps ---
mkdir -p /usr/share/arunlinux /usr/local/bin
cp -r "$SRC/apps"/* /usr/share/arunlinux/
cp -r "$SRC/assets/wallpapers" /usr/share/backgrounds/arunlinux 2>/dev/null || {
  mkdir -p /usr/share/backgrounds/arunlinux
  cp -r "$SRC/assets/wallpapers"/* /usr/share/backgrounds/arunlinux/
}
cp "$SRC/assets/logo.png" /usr/share/arunlinux/logo.png
# Setup scripts must ship too - arun-drivers / arun-welcome delegate to them
mkdir -p /usr/share/arunlinux/scripts
cp "$SRC/scripts"/*.sh /usr/share/arunlinux/scripts/ 2>/dev/null || true
# Distro icon (used by the Welcome Center .desktop entry)
install -Dm644 "$SRC/assets/arunlinux.svg" /usr/share/icons/hicolor/scalable/apps/arunlinux.svg
install -Dm644 "$SRC/assets/arunlinux.svg" /usr/share/pixmaps/arunlinux.svg
ln -sf /usr/share/arunlinux/arun-pkg/arun-pkg /usr/local/bin/arun-pkg
ln -sf /usr/share/arunlinux/arun-optimizer/arun-optimizer /usr/local/bin/arun-optimizer
ln -sf /usr/share/arunlinux/arun-wallpapers/arun-wallpapers /usr/local/bin/arun-wallpapers
ln -sf /usr/share/arunlinux/arun-welcome/arun-welcome /usr/local/bin/arun-welcome
ln -sf /usr/share/arunlinux/arun-drivers/arun-drivers /usr/local/bin/arun-drivers

# --- Desktop entries ---
for app in arun-welcome arun-wallpapers arun-optimizer; do
  if [ -f "/usr/share/arunlinux/$app/$app.desktop" ]; then
    ln -sf "/usr/share/arunlinux/$app/$app.desktop" /usr/share/applications/
  fi
done

# --- Welcome Center autostart for future users ---
mkdir -p /etc/skel/.config/autostart
cp /usr/share/arunlinux/arun-welcome/arun-welcome.desktop /etc/skel/.config/autostart/ 2>/dev/null || true

# --- Flatpak: add Flathub by default ---
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true

# --- Enable services ---
systemctl enable earlyoom 2>/dev/null || true
systemctl enable tlp 2>/dev/null || true
systemctl enable thermald 2>/dev/null || true
systemctl enable preload 2>/dev/null || true
systemctl enable fail2ban 2>/dev/null || true

# --- Security defaults: firewall policy + daily security updates ---
ufw default deny incoming >/dev/null 2>&1 || true
ufw default allow outgoing >/dev/null 2>&1 || true
# (ufw itself is enabled on installed systems by scripts/security-harden.sh)
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

# --- Clean up the build payload (wallpapers/apps already copied above) ---
rm -rf /arun-src

echo "==> [arunlinux hook] tweaks applied."
