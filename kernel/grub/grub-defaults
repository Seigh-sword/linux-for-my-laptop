# arunlinux GRUB tweaks — merge these into /etc/default/grub, then:
#   sudo update-grub
#
# GRUB_CMDLINE_LINUX_DEFAULT="quiet splash intel_iommu=on i915.enable_psr=1 i915.enable_fbc=1 zswap.enabled=0 nowatchdog nmi_watchdog=0 mitigations=auto"
# GRUB_TIMEOUT=5
# GRUB_GFXMODE=auto
#
# Notes:
#  - zswap.enabled=0 → we use zram instead (don't run both; zswap would
#    starve zram — see docs/KERNEL-TWEAKS.md)
#  - nowatchdog/nmi_watchdog=0 → tiny boot + battery win on laptops
#  - mitigations=auto → keep CPU security mitigations ON (safe default).
#    Speed demons can try mitigations=off but we don't recommend it.
